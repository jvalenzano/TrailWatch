# TrailWatch .gitignore

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Environment variables
.env
.env.local
*.env

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Secrets & Keys
*.pem
*.key
*.p12
service-account-*.json
google-credentials.json

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/
.hypothesis/

# Jupyter
.ipynb_checkpoints

# Logs
*.log
logs/

# Cloud artifacts (generated)
.gcloud/
.config/gcloud/

# Node (if using frontend tools)
node_modules/
package-lock.json
yarn.lock

# Conductor (will be generated)
.conductor/setup_state.json

# Temporary files
tmp/
temp/
*.tmp

# Database
*.db
*.sqlite
*.sqlite3

# OS
Thumbs.db
.DS_Store
